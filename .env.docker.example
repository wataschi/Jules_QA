# Docker + LM Studio (Mac Studio / Tailscale HTTPS)
# cp .env.lmstudio.example .env

QA_TARGET_URL=http://host.docker.internal:3000
QA_MODE=warm-up
QA_SCENARIO_PATH=scenarios/invalid-password.yaml

MIDSCENE_MODEL_BASE_URL=https://macstudio.tailXXXX.ts.net/v1
MIDSCENE_MODEL_API_KEY=lm-studio
MIDSCENE_MODEL_NAME=qwen3.6-35b-a3b
MIDSCENE_MODEL_FAMILY=qwen3-vl
MIDSCENE_MODEL_TIMEOUT=600000

PLANNER_MODEL_BASE_URL=https://macstudio.tailXXXX.ts.net/v1
PLANNER_MODEL_API_KEY=lm-studio
PLANNER_MODEL_NAME=qwen3.6-35b-a3b

EMBEDDING_MODEL_BASE_URL=https://macstudio.tailXXXX.ts.net/v1
EMBEDDING_MODEL_NAME=text-embedding-bge-m3

MIDSCENE_PREFERRED_LANGUAGE=Ukrainian
MIDSCENE_REPLANNING_CYCLE_LIMIT=30
