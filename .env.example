# LM Studio — Mac Studio через Tailscale (HTTPS)
# cp .env.lmstudio.example .env

LM_STUDIO_HOST=macstudio.tailXXXX.ts.net

MIDSCENE_MODEL_BASE_URL=https://macstudio.tailXXXX.ts.net/v1
MIDSCENE_MODEL_API_KEY=lm-studio
MIDSCENE_MODEL_NAME=qwen3.6-35b-a3b
MIDSCENE_MODEL_FAMILY=qwen3-vl
MIDSCENE_MODEL_TIMEOUT=600000

PLANNER_MODEL_BASE_URL=https://macstudio.tailXXXX.ts.net/v1
PLANNER_MODEL_API_KEY=lm-studio
PLANNER_MODEL_NAME=qwen3.6-35b-a3b

EMBEDDING_MODEL_BASE_URL=https://macstudio.tailXXXX.ts.net/v1
EMBEDDING_MODEL_NAME=text-embedding-bge-m3

MIDSCENE_PREFERRED_LANGUAGE=Ukrainian
QA_TARGET_URL=https://example.com
QA_MODE=warm-up
QA_SCENARIO_PATH=scenarios/invalid-password.yaml
MIDSCENE_REPLANNING_CYCLE_LIMIT=30

# ── Jules 2.0: сервер на Mac Studio ─────────────────────────────────────────
# Лише loopback: до сервера ходить `tailscale serve`, тому можна довіряти
# заголовку Tailscale-User-Login. У Docker — HOST=0.0.0.0 (задано в compose).
HOST=127.0.0.1
UI_PORT=3840
# Вимагати вхід (Tailscale або токен). Без цього API відкритий усім, хто бачить порт.
JULES_REQUIRE_AUTH=1
# Перші адміністратори й QA (логіни Tailscale через кому); решта — розробники.
JULES_ADMINS=lead@example.com
JULES_QA_USERS=qa@example.com
# Публічна адреса для посилань у статусі, PR-коментарях і Telegram.
JULES_PUBLIC_URL=https://macstudio.tailXXXX.ts.net
# Хости, з яких можна тягнути зовнішні картинки сторінок (крім самої Confluence).
JULES_ASSET_HOSTS=

# ── Confluence Server/Data Center (8.5) за OpenVPN ──────────────────────────
CONFLUENCE_BASE_URL=https://wiki.corp.local
# Персональний токен (PAT) сервісного облікового запису з правом читання потрібних просторів.
CONFLUENCE_TOKEN=
# Внутрішній центр сертифікації: шлях до PEM задається при старті Node.
# NODE_EXTRA_CA_CERTS=/etc/ssl/corp-ca.pem

# ── Jira Server/Data Center (9.12) ──────────────────────────────────────────
JIRA_BASE_URL=https://jira.corp.local
JIRA_TOKEN=

# ── Figma: токен користувача з місцем Full або Dev ──────────────────────────
FIGMA_TOKEN=

# ── Telegram (остання фаза) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
