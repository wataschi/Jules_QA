{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "playwright.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "midscene_run"]
}
