node_modules/
web/node_modules/
web/dist/
dist/
.env
.env.*
!.env.example
!.env.*.example
midscene_run/*
!midscene_run/.gitkeep
.stagehand-cache/*
!.stagehand-cache/.gitkeep
test-results/*
!test-results/.gitkeep
playwright-report/*
!playwright-report/.gitkeep
data/runs/*
!data/runs/.gitkeep
data/settings.json
data/secrets.vault
# Чутливі артефакти прогонів: cookie/сесії, профілі автентифікації, локальна БД
# реєстру та логи — жодного з них не має бути в git.
data/storage-states/
data/auth-profiles/
data/registry.db*
data/*.log
*.log

# Сторонні MCP-сервери лежать тут власними репозиторіями — у нашу історію
# вони не входять, інакше git запише їх зламаним вкладеним репо.
mcp-servers/
