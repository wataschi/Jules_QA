{
  "name": "jules-ai-qa",
  "version": "0.1.0",
  "private": true,
  "description": "Local MVP autonomous AI QA system (Playwright + Midscene + Stagehand)",
  "type": "module",
  "scripts": {
    "qa": "tsx src/cli/run.ts",
    "test": "playwright test",
    "test:warm-up": "cross-env QA_MODE=warm-up playwright test",
    "test:regression": "cross-env QA_MODE=regression playwright test",
    "report:aggregate": "tsx src/reporting/aggregate-report.ts",
    "qa:transpile": "tsx src/codegen/transpile.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-midscene-sleep.mjs && node scripts/patch-midscene-extractor.mjs",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:fast": "vitest run tests/unit tests/api",
    "test:ui": "playwright test e2e/dashboard.spec.ts --project=dashboard",
    "test:llm": "playwright test e2e/llm-*.spec.ts --project=llm --grep @llm",
    "test:all": "npm run test:fast && npm run test:llm",
    "test:docker:fast": "docker compose exec qa npm run test:fast",
    "test:docker:llm": "docker compose exec qa npm run test:llm",
    "test:docker:ui": "docker compose exec qa npm run test:ui",
    "vault": "tsx scripts/vault.ts",
    "ui:build": "npm --prefix web install --include=dev && npm --prefix web run build",
    "ui:start": "tsx src/server/start.ts",
    "ui:dev:server": "tsx src/server/start.ts",
    "ui:dev:web": "npm --prefix web run dev",
    "start": "npm run ui:start",
    "up": "docker compose up --build -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f qa",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f qa",
    "docker:check-llm": "tsx scripts/check-lmstudio.ts",
    "docker:llm:up": "docker compose --profile stack up -d ollama",
    "docker:llm:pull": "docker compose --profile stack run --rm ollama-pull",
    "docker:qa": "docker compose run --rm qa",
    "docker:warm-up": "docker compose run --rm qa npm run qa -- --scenario scenarios/invalid-password.yaml --mode warm-up",
    "docker:regression": "docker compose run --rm qa npm run qa -- --scenario scenarios/invalid-password.yaml --mode regression",
    "docker:report": "docker compose run --rm qa npm run report:aggregate -- invalid-password-registration",
    "docker:gpu:up": "docker compose --profile gpu up -d vllm"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^3.0.0",
    "@midscene/web": "^0.30.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "cross-env": "^7.0.3",
    "playwright-core": "^1.61.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
